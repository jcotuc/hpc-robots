# Auditor de repuestos. Copiar como .env (NO se sube a GitHub)
# Solo LEE CSHP producción: nunca cambia nada en CSHP ni en la app (solo escribe rep_auditoria y encola correos)
CSHP_PROD_URL=https://taller.hpc.com.gt/CSHP
CSHP_USUARIO=
CSHP_PASSWORD=

# Supabase de la app (ConsumosCS): rep_*, rep_auditoria y correos_cola
SUPABASE_URL=https://buzvogvkfdrlhboyndzy.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Monitor / dungeon (kkzo). Modo A: service_role de kkzo · Modo B: anon key + MONITOR_TOKEN
MONITOR_SUPABASE_URL=https://kkzovradqpptmsaakqlb.supabase.co
MONITOR_SUPABASE_KEY=
MONITOR_TOKEN=

# A quién le llegan los correos de diferencias (separados por coma)
AUDITOR_PARA=jcotuc@hpc.com.gt
# Solo audita movimientos desde esta fecha (AAAA-MM-DD). Vacío = hoy
AUDITAR_DESDE=
# Minutos de espera después de cargar/despachar antes de auditar (CSHP ya debe mostrarlo)
ESPERA_MIN=2
# Máximo de llamadas por corrida (cada una tarda unos segundos en CSHP)
MAX_LLAMADAS=15

# Trabas (minutos): se avisa una vez por correo cuando algo se queda detenido
TRABA_PENDIENTE_MIN=10
TRABA_BODEGA_MIN=60
TRABA_PICKEADO_MIN=15
TRABA_KB_MIN=30
# Resumen del día por correo (una vez, desde esta hora)
RESUMEN_HORA=18:00
