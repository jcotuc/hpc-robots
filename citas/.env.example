# Credenciales del worker Citas -> CSHP. Copiar como .env (NO se sube a GitHub)

# CSHP: npm run sync usa QA; npm run sync:prod usa produccion.
# La tarea programada (correr.cmd) usa AMBIENTE: qa o prod
AMBIENTE=qa
CSHP_QA_URL=https://tallerqa.hpc.com.gt/CSHP
CSHP_PROD_URL=https://taller.hpc.com.gt/CSHP
CSHP_USUARIO=
CSHP_PASSWORD=

# Supabase (Settings > API > service_role). Es secreta.
SUPABASE_URL=https://kkzovradqpptmsaakqlb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Centro de servicio donde se crean las llamadas (texto exacto de la lista en CSHP)
CSHP_CENTRO=Centro de Servicio Zona 4

# Maximo de equipos por corrida
MAX_EQUIPOS=20

# Solo procesar estas citas (IDs separados por coma). Vacio = todas
SOLO_CITAS=
