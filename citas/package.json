{
  "name": "hpc-citas-worker",
  "private": true,
  "type": "module",
  "description": "Crea las llamadas de servicio en CSHP para los equipos en estado Pendiente",
  "scripts": {
    "sync": "node --env-file=.env sync-citas.mjs --qa --visible",
    "sync:buscar": "node --env-file=.env sync-citas.mjs --qa --visible --solo-buscar",
    "sync:buscar:prod": "node --env-file=.env sync-citas.mjs --prod --visible --solo-buscar",
    "sync:prod": "node --env-file=.env sync-citas.mjs --prod",
    "sync:auto": "node --env-file=.env sync-citas.mjs",
    "probar": "node --env-file=.env probar-conexion.mjs",
    "log": "node ver-log.mjs",
    "vivo": "node ver-vivo.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.0",
    "playwright": "^1.61.1"
  }
}
