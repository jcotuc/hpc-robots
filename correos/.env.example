# Robot de correos. Copiar como .env (NO se sube a GitHub)
# Si un valor tiene # espacios o $, escribelo entre comillas simples: CLAVE='...'

# qa = todo se manda a REDIRIGIR_A · prod = envio real
AMBIENTE=qa
REDIRIGIR_A=jcotuc@hpc.com.gt

# Supabase de ConsumosCS (Settings -> API Keys -> service_role / secret). NUNCA la compartas.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# outlook = usa el Outlook de escritorio abierto en esta PC (sin Azure). smtp = smtp.office365.com (requiere SMTP AUTH activo)
CORREO_MODO=outlook
# Cuenta que envia. En modo outlook debe estar agregada en ese Outlook (vacio = la cuenta principal)
CORREO_REMITENTE=jcotuc@hpc.com.gt

# --- Solo modo smtp
SMTP_USUARIO=
SMTP_PASSWORD=

# Link del boton en los correos (ej. https://consumoscs.lovable.app)
APP_URL=

# Maximo de correos por corrida · intentos antes de marcar error · cada cuanto corre la tarea (segundos)
MAX_CORREOS=20
MAX_INTENTOS=5
INTERVALO_SEG=120

# --- Monitor (dungeon). Generar el token con nuevo-token-robot.ps1 en la raiz del repo
MONITOR_SUPABASE_URL=
MONITOR_SUPABASE_KEY=
MONITOR_TOKEN=
# ROBOT_PC=
