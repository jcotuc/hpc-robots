# Robot de digitadores. Copiar como .env (NO se sube a GitHub)

# La tarea programada usa AMBIENTE: qa o prod
AMBIENTE=qa
CSHP_QA_URL=https://tallerqa.hpc.com.gt/CSHP
CSHP_PROD_URL=https://taller.hpc.com.gt/CSHP
CSHP_USUARIO=
CSHP_PASSWORD=
# Opcional: usuario distinto solo para produccion
CSHP_PROD_USUARIO=
CSHP_PROD_PASSWORD=

# Supabase de ConsumosCS (Bandeja)
SUPABASE_URL=https://buzvogvkfdrlhboyndzy.supabase.co
# Settings -> API Keys -> service_role / secret. NUNCA la compartas.
SUPABASE_SERVICE_ROLE_KEY=

# Nombre con el que el robot queda en el historial de la Bandeja
ROBOT_NOMBRE=robot-digitadores
# Estado de la Bandeja que procesa
ESTADO_BANDEJA=Garantía

# Status de CSHP
CSHP_STATUS_FACTURACION=108
# Solo LLS: despues de facturar pasa a Logistica envio (LLM se queda como la deja Facturar)
CSHP_STATUS_LOGISTICA=106
# Tipologia segun el tipo de mantenimiento: 101 = Reparacion, 123 = Mantenimiento
CSHP_TIPOLOGIA_CORRECTIVO=101
CSHP_TIPOLOGIA_PREVENTIVO=123

# Maximo de llamadas por corrida (0 = todas)
MAX_LLAMADAS=0
# Solo estas llamadas (separadas por coma), util en pruebas. Vacio = todas
SOLO_LLAMADAS=
# Solo QA: llamada de CSHP QA donde se prueba (con UNA llamada en SOLO_LLAMADAS)
QA_LLAMADA_CSHP=
