# Credenciales del robot de guias. Copiar como .env (NO se sube a GitHub)
# Si la contrasena tiene # espacios o $, escribela entre comillas simples: CSHP_PASSWORD='...'

# La tarea programada (correr.cmd) usa AMBIENTE: qa o prod
AMBIENTE=qa
CSHP_QA_URL=https://tallerqa.hpc.com.gt/CSHP
CSHP_PROD_URL=https://taller.hpc.com.gt/CSHP
CSHP_USUARIO=
CSHP_PASSWORD=
# Opcional: usuario distinto solo para produccion
CSHP_PROD_USUARIO=
CSHP_PROD_PASSWORD=

# Filtro de la lista de llamadas (valores de los combos en CSHP)
CSHP_CENTRO=HPCS016
CSHP_ESTADO_BUSCAR=106
# Texto que se escribe en el campo Llamada (LLS = no mezcla con LLM)
CSHP_FILTRO_LLAMADA=LLS
# Nuevo Status al presionar Cambiar Status. Vacio = el que CSHP propone (como la grabacion)
CSHP_ESTADO_NUEVO=

# Nombre EXACTO de la impresora en Windows (setup.cmd te deja elegirlas de una lista)
IMPRESORA_GUIA=
IMPRESORA_DIAGNOSTICO=
# Segundos de espera despues de mandar cada documento a imprimir
ESPERA_IMPRESION_SEG=3

# Maximo de llamadas por corrida (0 = hasta vaciar la lista)
MAX_LLAMADAS=0
# Solo estas llamadas (separadas por coma), util en pruebas. Vacio = todas
SOLO_LLAMADAS=

# --- Monitor (dungeon). Generar el token con nuevo-token-robot.ps1 en la raiz del repo
MONITOR_SUPABASE_URL=https://kkzovradqpptmsaakqlb.supabase.co
MONITOR_SUPABASE_KEY=
MONITOR_TOKEN=
# ROBOT_PC=Robot Guias
