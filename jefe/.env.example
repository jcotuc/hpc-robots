# El Jefe. Copiar como .env (NO se sube a GitHub)
# qa = solo muestra en consola lo que encontró · prod = guarda hallazgos, reporta al dungeon y manda correos
AMBIENTE=qa

# Supabase kkzo (citas / monitor): la service_role del .env de citas
KKZO_URL=https://kkzovradqpptmsaakqlb.supabase.co
KKZO_SERVICE_ROLE_KEY=

# Supabase ConsumosCS (digitadores / correos): la service_role del .env de digitadores
CONSUMOS_URL=
CONSUMOS_SERVICE_ROLE_KEY=

# A quién avisa por correo cuando abre un hallazgo ALTO (separar con coma). Vacío = no manda correos
ALERTAR_A=jcotuc@hpc.com.gt

# Nombre del robot de digitadores en la Bandeja (ROBOT_NOMBRE de digitadores)
DIGITADORES_ROBOT=robot-digitadores

# Umbrales (minutos)
CITAS_ATORADA_MIN=30
CORREO_ATRASADO_MIN=15
GARANTIA_SIN_TOMAR_MIN=60

# Monitor: el jefe también aparece en el dungeon (usa kkzo)
MONITOR_SUPABASE_URL=https://kkzovradqpptmsaakqlb.supabase.co
MONITOR_SUPABASE_KEY=

# CSHP (solo lectura): mismos datos que digitadores
CSHP_PROD_URL=
CSHP_PROD_USUARIO=
CSHP_PROD_PASSWORD=
MAX_AUDITAR=10
# Solo audita llamadas digitadas desde esta fecha (ISO, UTC). Vacío = últimos 2 días
AUDITAR_DESDE=
