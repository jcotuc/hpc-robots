# Credenciales del worker MiMO -> CSHP. Copiar como .env (NO se sube a GitHub)
# Si la contraseña o la key tienen # espacios o $, escríbelas entre comillas simples: CSHP_PASSWORD='...'

# CSHP: npm run sync usa QA; npm run sync:prod usa produccion.
# La tarea programada (correr.cmd) usa AMBIENTE: qa o prod
AMBIENTE=qa
CSHP_QA_URL=https://tallerqa.hpc.com.gt/CSHP
CSHP_PROD_URL=https://taller.hpc.com.gt/CSHP
CSHP_USUARIO=
CSHP_PASSWORD=
# Opcional: usuario distinto solo para produccion
CSHP_PROD_USUARIO=
CSHP_PROD_PASSWORD=

# Supabase (Settings > API > service_role). Es secreta.
SUPABASE_URL=https://kkzovradqpptmsaakqlb.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Centro de servicio donde se crean las llamadas (texto exacto de la lista en CSHP)
CSHP_CENTRO=Centro de Servicio Zona 4
# Status que se elige en Cambiar Status despues de crear la llamada (texto igual al de la lista)
CSHP_ESTADO_RUTA=T - En Ruta

# Maximo de equipos por corrida
MAX_EQUIPOS=20

# Solo procesar estos numeros MiMo (separados por coma). Vacio = todos
SOLO_MIMO=
