# Robot de solicitud de repuestos. Copiar como .env (NO se sube a GitHub)
AMBIENTE=qa
CSHP_QA_URL=https://tallerqa.hpc.com.gt/CSHP
CSHP_PROD_URL=https://taller.hpc.com.gt/CSHP
# Usuario genérico de técnico
CSHP_USUARIO=
CSHP_PASSWORD=
CSHP_PROD_USUARIO=
CSHP_PROD_PASSWORD=

# Supabase de la app de solicitudes (se usa cuando la app exista)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

ROBOT_NOMBRE=robot-solicitud-repuestos
ROBOT_CENTRO=Nodus

# Pruebas en QA (npm.cmd run prueba). Repuestos como SKU:cantidad separados por coma
PRUEBA_LLAMADA=LLS21-274650
PRUEBA_TECNICO=TB30004
PRUEBA_REPUESTOS=18023:2,925207:1

# Usuario de bodega para HH (consulta de existencias y despacho)
HH_USUARIO=
HH_PASSWORD=
