# Robot Catalogo Truper. Copiar como .env (NO se sube a GitHub)

# Ritmo con truper.com (subir DELAY_MS o bajar CONCURRENCY si da HTTP 403/429)
DELAY_MS=800
CONCURRENCY=3
# La lista y el cache se renuevan solos si tienen mas de estos dias (la tarea mensual trae el catalogo nuevo)
DIAS_REFRESCO=20
# Mas de este % de fichas con error = la corrida queda en ERROR en el dungeon
MAX_ERROR_PCT=2

# --- Monitor (dungeon). Misma PC que correos: se pueden copiar de correos\.env
MONITOR_SUPABASE_URL=
MONITOR_SUPABASE_KEY=
MONITOR_TOKEN=
# ROBOT_PC=
