    "nuevo": "node --env-file=.env scraper.mjs --nuevo",
    "prueba": "node --env-file=.env scraper.mjs --limit 20"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "exceljs": "^4.4.0"
  }
}
